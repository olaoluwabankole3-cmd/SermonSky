{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sermonsky",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sermonsky-db",
      "database_id": "e0bfb134-5283-41a8-b4e5-3f9967e1246d"
    }
  ]
}
